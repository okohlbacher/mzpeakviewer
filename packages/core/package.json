  "description": "Phase 3: the ONE Web Worker data engine. Owns the mzpeakts Reader + scheduler + LRU cache in-worker; exposes every read/compute as a typed @mzpeak/contracts message. Consumed as source (the app bundles the worker with the wasm plugins).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker/engine.worker.ts"
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mzpeak/contracts": "*",
    "@zip.js/zip.js": "2.23.0",
    "apache-arrow": "21.2.0",
    "arrow-js-ffi": "0.4.3",
    "geotiff": "3.0.5",
    "hyparquet": "^1.31.3",
    "hyparquet-compressors": "^1.1.2",
    "mzpeakts": "file:../../vendor/mzpeakts/lib",
    "parquet-wasm": "0.7.1"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "utif2": "^4.1.0",
    "vitest": "5.0.4"
  }
}
